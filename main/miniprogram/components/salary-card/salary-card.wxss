/* 银行卡 ISO 比例宽 : 高 ≈ 1.586 : 1；与纸袋约 7 : 10 宽比 */

.card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    width: 600rpx;
    max-width: 100%;
    height: 378rpx;
    padding: 28rpx 36rpx 32rpx;
    border-radius: 22rpx;
    overflow: hidden;
    background: linear-gradient(
        125deg,
        #1c1c1e 0%,
        #2c2c2e 38%,
        #1a2332 72%,
        #0f1419 100%
    );
    box-shadow:
        0 4rpx 2rpx rgba(255, 255, 255, 0.06) inset,
        0 16rpx 40rpx rgba(0, 0, 0, 0.2),
        0 6rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-texture {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    opacity: 0.35;
    background:
        repeating-linear-gradient(
            -18deg,
            transparent,
            transparent 8rpx,
            rgba(255, 255, 255, 0.03) 8rpx,
            rgba(255, 255, 255, 0.03) 9rpx
        ),
        radial-gradient(ellipse 120% 80% at 85% 15%, rgba(201, 162, 98, 0.18) 0%, transparent 55%);
    pointer-events: none;
}

.card-shine {
    position: absolute;
    top: -100rpx;
    right: -40rpx;
    width: 260rpx;
    height: 260rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 68%);
    pointer-events: none;
}

.card-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.card-brand {
    color: rgba(255, 255, 255, 0.92);
    font-size: 24rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.card-pay {
    position: relative;
    width: 40rpx;
    height: 28rpx;
    margin-top: 2rpx;
}

.card-pay-arc {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40rpx;
    height: 40rpx;
    border: 3rpx solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    border-color: rgba(255, 255, 255, 0.5) transparent transparent transparent;
    transform: rotate(-45deg);
}

.card-pay-arc.arc-2 {
    right: 9rpx;
    width: 30rpx;
    height: 30rpx;
    opacity: 0.75;
}

.card-pay-arc.arc-3 {
    right: 18rpx;
    width: 22rpx;
    height: 22rpx;
    opacity: 0.5;
}

.card-chip {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    width: 92rpx;
    height: 68rpx;
    margin-top: 12rpx;
    padding: 12rpx 14rpx;
    border-radius: 11rpx;
    background: linear-gradient(145deg, #e8d4a8 0%, #c9a86c 42%, #a8844a 100%);
    box-shadow:
        inset 0 1rpx 0 rgba(255, 255, 255, 0.45),
        inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.15),
        0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.chip-line {
    height: 3rpx;
    border-radius: 1rpx;
    background: rgba(80, 55, 25, 0.35);
}

.card-bottom {
    position: relative;
    z-index: 1;
    margin-top: auto;
}

.card-label {
    display: block;
    color: rgba(255, 255, 255, 0.55);
    font-size: 22rpx;
    letter-spacing: 5rpx;
}

.card-amount {
    display: flex;
    align-items: baseline;
    margin-top: 8rpx;
}

.card-currency {
    margin-right: 8rpx;
    color: #e8d4a8;
    font-size: 32rpx;
    font-weight: 600;
}

.card-value {
    color: #ffffff;
    font-size: 50rpx;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1rpx;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}
