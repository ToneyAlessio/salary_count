<!-- 薪资页：上-实时薪 / 中-小金库组件 / 下-倒计时与进度条 -->
<view class="page">
    <view class="block-main">
    <!-- 实时薪资 + 状态 + 提现 -->
    <view class="block-live">
        <text class="block-title">实时薪资</text>
        <view class="amount-row amount-row-lg">
            <text class="currency">¥</text>
            <text class="amount live">{{liveSalaryText}}</text>
        </view>
        <text class="status-pill">{{statusText}}</text>
        <button
            class="btn-withdraw"
            bindtap="onWithdraw"
            disabled="{{!canWithdraw}}"
        >
            提现
        </button>
    </view>

    <!-- 累计已提现金额（牛皮纸袋） -->
    <view class="block-pouch">
        <vault-bag
            amount="{{pouchSalaryText}}"
            can-clock-out="{{canClockOut}}"
            bind:clockout="onClockOut"
        />
    </view>

    <view class="block-card">
        <salary-card amount="{{cardIncomeText}}" />
    </view>
    </view>

    <!-- 距离上班/下班剩余时长 + 进度条（贴底） -->
    <view class="block-progress">
        <view class="progress-meta">
            <text class="progress-meta-label">{{countdownLabel}}</text>
            <view class="countdown-hms">
                <view class="countdown-seg">
                    <text class="countdown-num">{{countdownH}}</text>
                    <text class="countdown-unit">h</text>
                </view>
                <text class="countdown-colon">:</text>
                <view class="countdown-seg">
                    <text class="countdown-num">{{countdownM}}</text>
                    <text class="countdown-unit">m</text>
                </view>
                <text class="countdown-colon">:</text>
                <view class="countdown-seg">
                    <text class="countdown-num">{{countdownS}}</text>
                    <text class="countdown-unit">s</text>
                </view>
            </view>
        </view>

        <view class="progress-track-wrap">
            <view class="progress-row">
                <view class="progress-gutter" aria-hidden="true"></view>
                <view class="progress-track">
                    <view class="progress-fill-wrap" style="width: {{progressPercent}}%;">
                        <view class="progress-fill"></view>
                        <view class="progress-thumb" wx:if="{{progressPercent > 0}}"></view>
                    </view>
                </view>
                <view class="progress-gutter" aria-hidden="true"></view>
            </view>
            <view class="progress-foot">
                <text class="time-mark time-mark-start">{{progressFootStart}}</text>
                <view class="progress-foot-inner">
                    <text
                        wx:if="{{showProgressNow}}"
                        class="time-mark time-mark-follow"
                        style="left: {{progressLabelLeft}}%;"
                    >{{progressFootNow}}</text>
                </view>
                <text class="time-mark time-mark-end">{{progressFootRight}}</text>
            </view>
        </view>
    </view>
</view>
