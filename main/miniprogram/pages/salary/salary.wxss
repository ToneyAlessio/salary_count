/* 纵向三区：实时薪、小金库、进度条贴底（margin-top: auto） */

.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 40rpx 64rpx;
    display: flex;
    flex-direction: column;
    gap: 36rpx;
}

.block-title {
    color: #8a9099;
    font-size: 28rpx;
}

/* ---------- 实时薪资（顶部） ---------- */
.block-live {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24rpx 16rpx 8rpx;
}

.amount-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
}

.amount-row-lg {
    margin-top: 16rpx;
}

.currency {
    margin-right: 8rpx;
    color: #1f2329;
    font-weight: 600;
}

.amount-row-lg .currency {
    font-size: 44rpx;
}

.amount {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1rpx;
}

.amount.live {
    color: #1769e0;
    font-size: 80rpx;
}

.status-pill {
    margin-top: 20rpx;
    padding: 8rpx 24rpx;
    border-radius: 999rpx;
    background: #eef4fc;
    color: #1769e0;
    font-size: 24rpx;
}

.btn-withdraw {
    margin-top: 28rpx;
    width: 320rpx;
    height: 80rpx;
    padding: 0;
    border-radius: 40rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 80rpx;
    text-align: center;
}

.btn-withdraw::after {
    border: none;
}

.btn-withdraw:active {
    background: #1257bd;
}

.btn-withdraw[disabled] {
    background: #c3c8cf;
    color: #ffffff;
}

/* ---------- 小金库 ---------- */
.block-pouch {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rpx 0 12rpx;
}

/* ---------- 实时进度条（底部） ---------- */
.block-progress {
    margin-top: auto;
    padding: 16rpx 8rpx 0;
}

.progress-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.progress-meta-label {
    color: #8a9099;
    font-size: 28rpx;
}

.progress-meta-value {
    color: #1769e0;
    font-size: 32rpx;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

.progress-track {
    position: relative;
    height: 20rpx;
    border-radius: 999rpx;
    background: rgba(31, 35, 41, 0.08);
    overflow: visible;
}

.progress-fill-wrap {
    position: relative;
    height: 100%;
    min-width: 0;
    max-width: 100%;
    transition: width 1s linear;
}

.progress-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #8ec0ff 0%, #1769e0 100%);
    box-shadow: 0 2rpx 12rpx rgba(23, 105, 224, 0.35);
}

.progress-thumb {
    position: absolute;
    top: 50%;
    right: 0;
    width: 28rpx;
    height: 28rpx;
    border-radius: 50%;
    background: #ffffff;
    border: 4rpx solid #1769e0;
    box-shadow: 0 4rpx 12rpx rgba(23, 105, 224, 0.25);
    transform: translate(50%, -50%);
}

.progress-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 20rpx;
    padding: 0 4rpx;
}

.time-mark {
    color: #8a9099;
    font-size: 24rpx;
    font-variant-numeric: tabular-nums;
}
