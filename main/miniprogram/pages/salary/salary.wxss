/* 主内容在上，进度条区 margin-top: auto 贴屏幕底 */

.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 40rpx 32rpx 48rpx;
    display: flex;
    flex-direction: column;
}

.block-main {
    display: flex;
    flex-direction: column;
    gap: 28rpx;
}

.block-title {
    color: #8a9099;
    font-size: 28rpx;
}

/* ---------- 实时薪资（顶部） ---------- */
.block-live {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    padding: 12rpx 16rpx 4rpx;
}

.amount-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
}

.amount-row-lg {
    margin-top: 16rpx;
}

.currency {
    margin-right: 8rpx;
    color: #1f2329;
    font-weight: 600;
}

.amount-row-lg .currency {
    font-size: 44rpx;
}

.amount {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1rpx;
}

.amount.live {
    color: #1769e0;
    font-size: 72rpx;
}

.status-pill {
    margin-top: 20rpx;
    padding: 8rpx 24rpx;
    border-radius: 999rpx;
    background: #eef4fc;
    color: #1769e0;
    font-size: 24rpx;
}

.btn-withdraw {
    margin-top: 24rpx;
    width: 480rpx;
    max-width: 100%;
    height: 76rpx;
    padding: 0;
    border-radius: 40rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 76rpx;
    text-align: center;
}

.btn-withdraw::after {
    border: none;
}

.btn-withdraw:active {
    background: #1257bd;
}

.btn-withdraw[disabled] {
    background: #c3c8cf;
    color: #ffffff;
}

/* ---------- 小金库（纸袋 + 下班） ---------- */
.block-pouch {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    padding: 0;
}

/* ---------- 工资卡 ---------- */
.block-card {
    display: flex;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    padding: 4rpx 0 8rpx;
}

/* ---------- 实时进度条（贴页面最底） ---------- */
.block-progress {
    flex-shrink: 0;
    width: 100%;
    margin-top: auto;
    padding: 24rpx 8rpx 0;
}

.progress-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.progress-meta-label {
    color: #8a9099;
    font-size: 28rpx;
}

.countdown-hms {
    display: flex;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
}

.countdown-seg {
    display: flex;
    align-items: baseline;
}

.countdown-num {
    color: #1769e0;
    font-size: 36rpx;
    font-weight: 700;
    line-height: 1;
}

.countdown-unit {
    margin-left: 4rpx;
    color: #8a9099;
    font-size: 22rpx;
    font-weight: 500;
    line-height: 1;
}

.countdown-colon {
    margin: 0 10rpx;
    color: #c3c8cf;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 1;
}

.progress-track-wrap {
    position: relative;
}

.progress-row,
.progress-foot {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.progress-gutter,
.time-mark-start,
.time-mark-end {
    flex-shrink: 0;
    width: 56rpx;
}

.progress-gutter {
    height: 1rpx;
}

.time-mark-start,
.time-mark-end {
    text-align: center;
}

.progress-track {
    flex: 1;
    min-width: 0;
    position: relative;
    height: 20rpx;
    border-radius: 999rpx;
    background: rgba(31, 35, 41, 0.08);
    overflow: visible;
}

.progress-fill-wrap {
    position: relative;
    height: 100%;
    min-width: 0;
    max-width: 100%;
    transition: width 1s linear;
}

.progress-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #8ec0ff 0%, #1769e0 100%);
    box-shadow: 0 2rpx 12rpx rgba(23, 105, 224, 0.35);
}

.progress-thumb {
    position: absolute;
    top: 50%;
    right: 0;
    width: 28rpx;
    height: 28rpx;
    border-radius: 50%;
    background: #ffffff;
    border: 4rpx solid #1769e0;
    box-shadow: 0 4rpx 12rpx rgba(23, 105, 224, 0.25);
    transform: translate(50%, -50%);
}

.progress-foot {
    margin-top: 20rpx;
}

.progress-foot-inner {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 36rpx;
}

.time-mark {
    color: #8a9099;
    font-size: 24rpx;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.time-mark-follow {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    color: #1769e0;
    font-weight: 500;
}

